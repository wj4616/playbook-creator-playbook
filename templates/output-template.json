      "anthropic": {
        "_note": "Claude Code Max, high budget (default)",
        "frontier": "claude-opus-5",
        "high": "claude-sonnet-5",
        "fast": "claude-haiku-4-5",
        "window_tokens": 200000,
        "large_window_tokens": 1000000
      },
      "openai_codex": {
        "_note": "OpenAI Codex CLI; single model across tiers",
        "frontier": "gpt-5.5",
        "high": "gpt-5.5",
        "fast": "gpt-5.5",
        "window_tokens": 400000
      },
      "generic": {
        "_note": "map your models to tiers",
        "frontier": "<strongest>",
        "high": "<mid>",
        "fast": "<fast>",
        "window_tokens": 128000
      }
    },
    "tier_aliases": {
      "opus": "frontier",
      "sonnet": "high",
      "haiku": "fast"
